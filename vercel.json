{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "next build",
  "framework": "nextjs",
  "redirects": [
    {
      "source": "/.well-known/farcaster.json",
      "destination": "https://api.farcaster.xyz/miniapps/hosted-manifest/019e74e6-04ac-7250-c06b-e956351e2e94",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/echo/referral/cron",
      "schedule": "0 0 * * *"
    }
  ]
}